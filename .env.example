# FinRAG 2.0 configuration template.
#
# Copy to .env and fill in the secrets. .env is git-ignored; this file is not,
# so it must never contain a real credential — placeholders only.
#
# Precedence (highest first): Settings kwargs > process env vars > .env > defaults.
#
# Do NOT put a comment on the same line as a value (FOO=bar  # note). The env
# loader does not strip trailing inline comments, so "# note" becomes part of
# the value and later fails validation. Comment on the line above instead.

# ---- App ----
APP_NAME=FinRAG
# dev | test | prod
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info

# ---- MongoDB (primary store) ----
# Use 127.0.0.1 rather than "localhost": on Windows localhost can resolve to
# ::1 and reach a different server. Started by infra/docker-compose.yml on host
# port 27019 — a native mongod.exe service owns 27017 here and cannot serve
# $vectorSearch/$search.
MONGODB_URL=mongodb://127.0.0.1:27019
MONGODB_DB_NAME=finrag
# The isolation suite runs against this separate instance (compose maps it to
# host 27018) so tests can never touch the application database.
MONGODB_TEST_URL=mongodb://127.0.0.1:27018/?directConnection=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ---- Vector store ----
# atlas (default) uses MongoDB $vectorSearch; qdrant is kept as an alternative.
VECTOR_STORE=atlas
# MUST match the embedding model output size
VECTOR_DIM=384
EMBEDDINGS_SEARCH_INDEX_NAME=chunks_vector
ATLAS_SEARCH_INDEX_NAME=chunks_text

# Legacy/local Qdrant fallback. local = embedded file store, remote = a server.
QDRANT_MODE=remote
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks
# Only used when QDRANT_MODE=local. Leave empty in containers.
QDRANT_PATH=./data/qdrant

# ---- Storage ----
STORAGE_PATH=./data/storage
UPLOAD_MAX_SIZE_MB=100

# ---- LLM gateway (OpenAI-compatible) ----
LLM_PROVIDER=omniroute
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=replace-with-your-gateway-key
# Accepted as aliases of the two above; prefer the LLM_* names.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=replace-with-your-gateway-key

# Model roles — values, not code. Only nvidia/* on the gateway, Ollama last.
# Verified against the gateway on 2026-10-17; see docs/STATUS.md.
CHAT_MODEL=nvidia/nvidia/nemotron-3-super-120b-a12b
REASONING_MODEL=nvidia/nvidia/nemotron-3-super-120b-a12b
VISION_MODEL=nvidia/meta/llama-3.2-11b-vision-instruct
# No nvidia/* model serves embeddings or reranking through this gateway, so
# embeddings come from local Ollama. Keep EMBEDDING_DIM in sync with VECTOR_DIM.
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_DIM=768
RERANK_MODEL=
FALLBACK_CHAIN=nvidia/nvidia/nemotron-3-super-120b-a12b,nvidia/poolside/laguna-xs-2.1,nvidia/stepfun-ai/step-5-preview,ollama/llama3.1
ALLOWED_PROVIDERS=nvidia,ollama

# ---- Local Ollama (embeddings + last-resort chat) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDINGS_PROVIDER=ollama

# ---- Retrieval ----
RETRIEVAL_TOP_K=10
HYBRID_DENSE_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
RERANKER_PROVIDER=stub
RERANKER_TOP_K=5
COHERE_API_KEY=

# ---- Auth ----
# Must be a random value of >= 32 characters when APP_ENV=prod; the app refuses
# to boot with the default in prod.
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
JWT_TTL_MINUTES=720
API_KEY_HEADER=X-API-Key
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---- Jobs ----
# inproc | celery
JOBS_MODE=inproc
REDIS_URL=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Testing ----
# Fail instead of skipping when the real MongoDB on MONGODB_TEST_URL is
# unreachable. Recommended always-on; documented as the default test command.
REQUIRE_MONGO=1
