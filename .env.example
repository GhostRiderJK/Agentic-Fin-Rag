# ──────────────────────────────────────────────────────────────────────────────
# FinRAG 2.0 — environment template
# Copy to `.env` and fill in. `.env` is git-ignored. NEVER commit real keys.
# ──────────────────────────────────────────────────────────────────────────────

# ---- App ----
APP_NAME="Investment Research Assistant"
APP_ENV=dev                       # dev | test | prod
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info                # debug | info | warning | error

# ---- Database (MongoDB for production, SQLite for dev) ----
# MongoDB: mongodb://user:pass@localhost:27017/finrag?authSource=admin
   MONGODB_URL=mongodb://127.0.0.1:27017
   MONGODB_TEST_URL=mongodb://127.0.0.1:27018/?directConnection=true

# ---- Vector DB (Qdrant local by default) ----
QDRANT_MODE=local                 # local | remote
QDRANT_PATH=./data/qdrant
QDRANT_URL=                       # set when QDRANT_MODE=remote
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# ---- Storage ----
STORAGE_PATH=./data/storage
UPLOAD_MAX_SIZE_MB=100

# ---- LLM Provider Configuration ----
LLM_PROVIDER=omnirroute           # openai | anthropic | ollama | stub | omnirroute

# OmniRoute Configuration (required when LLM_PROVIDER=omnirroute)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=                # Required when using OmniRoute

# Model Configuration (pinned IDs as required - never use auto/strategy)
CHAT_MODEL=nvidia/nvidia/nemotron-3-super-120b-a12b
REASONING_MODEL=nvidia/nvidia/nemotron-3-ultra-550b-a55b
VISION_MODEL=                     # e.g., nvidia/microsoft/phi-3-vision-128k-instruct
EMBEDDING_MODEL=                  # e.g., sentence-transformers/all-MiniLM-L6-v2 (local)
RERANK_MODEL=                     # e.g., cohere/rerank-english-v3.0

# Fallback chain (explicit pinned IDs in order of preference)
FALLBACK_CHAIN=nvidia/nvidia/nemotron-3-super-120b-a12b,ollama/llama3.1

# Provider allow-list (security: tenant documents only go to approved providers)
ALLOWED_PROVIDERS=nvidia,ollama

# ---- Embeddings ----
EMBEDDINGS_PROVIDER=stub          # openai | stub | sentence_transformers
EMBEDDINGS_DIM=1536
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-small-en-v1.5

# ---- Reranker ----
RERANKER_PROVIDER=stub            # stub | cohere | cross_encoder
RERANKER_TOP_K=5
COHERE_API_KEY=

# ---- Retrieval ----
RETRIEVAL_TOP_K=10
HYBRID_DENSE_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4

# ---- Auth / Security ----
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
JWT_TTL_MINUTES=720
API_KEY_HEADER=X-API-Key

# ---- Jobs ----
JOBS_MODE=inproc                  # inproc | celery
REDIS_URL=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000